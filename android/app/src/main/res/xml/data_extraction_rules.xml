<?xml version="1.0" encoding="utf-8"?>
<!-- 안드로이드 12 이상: 구글 계정 백업과 새 폰으로 옮기기. 사진은 백업에서만 뺀다(용량 한도). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <exclude domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
