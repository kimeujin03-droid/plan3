{
  // MOA API 워커 설정. 배포: GitHub Actions의 "Deploy API" 또는 이 폴더에서 `npx wrangler deploy`.
  "name": "moa-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "vars": {
    // 쓰는 Gemini 모델. 바꾸고 싶으면 여기만 고친다.
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  },
  // 한 IP당 1분에 20번까지. 넘으면 429를 돌려주고 앱은 메모로 남긴다.
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // 요청 수와 오류만 본다. 워커 코드는 사용자의 문장을 로그에 쓰지 않는다.
  "observability": { "enabled": true }
}
